{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "nustweshare",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"NEXT_PUBLIC_APP_URL": "https://nustweshare.workers.dev"
	},
	"r2_buckets": [
		{
			"binding": "PAPERS_BUCKET",
			"bucket_name": "nustweshare-papers",
			"preview_bucket_name": "nustweshare-papers"
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "507d02782751464e9d9b46bcd732f2ea",
			"localConnectionString": "postgresql://user:pass@localhost:5432/db"
		}
	],
	"env": {
		"preview": {
			"vars": {
				"NEXT_PUBLIC_APP_URL": "https://preview.nustweshare.workers.dev"
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "507d02782751464e9d9b46bcd732f2ea",
					"localConnectionString": "postgresql://user:pass@localhost:5432/db"
				}
			],
			"r2_buckets": [
				{
					"binding": "PAPERS_BUCKET",
					"bucket_name": "nustweshare-papers",
					"preview_bucket_name": "nustweshare-papers"
				}
			]
		}
	}
}
