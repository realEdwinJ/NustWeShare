# Database — Neon / Supabase / local Postgres free tier
DATABASE_URL=postgresql://user:password@host:5432/nustweshare?sslmode=require

# Cloudflare R2 — native Worker binding PAPERS_BUCKET (no credentials in Worker, Spec 16)
# Wrangler automatically binds R2 bucket via wrangler.toml [[r2_buckets]] binding = "PAPERS_BUCKET" bucket_name = "nustweshare-papers"
# For local dev without R2, files stored in ./uploads (not for production, Spec 48)
# No R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY needed in Worker

# App secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change_me_64_char_random_hex
ADMIN_SECRET=change_me_32_char_random_hex_for_restore

# Public (exposed to client)
NEXT_PUBLIC_APP_URL=http://localhost:3000
