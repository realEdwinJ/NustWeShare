# Database — Neon / Supabase / local Postgres free tier
DATABASE_URL=postgresql://user:password@host:5432/nustweshare?sslmode=require

# Cloudflare R2 — private bucket for PDFs (Spec 16, 48)
R2_BUCKET=nustweshare-papers
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_URL=https://papers.nustweshare.example.com

# App secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change_me_64_char_random_hex
ADMIN_SECRET=change_me_32_char_random_hex_for_restore

# Public (exposed to client)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: for local dev without R2, files stored in ./uploads (not for production)
# STORAGE_ADAPTER=r2
